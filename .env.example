# ══════════════════════════════════════════════════════════════════
# Nogoolin — environment variables (NFR-MAIN-008, 08-security.md §11)
# Copy to .env and fill in real values. NEVER commit real secrets.
# All values below are placeholders.
# ══════════════════════════════════════════════════════════════════

# ── Server (backend/api) ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# ⚠️ Server-only — bypasses RLS. Never expose to web or mobile clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── CORS (comma-separated allowed origins) ───────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting (@fastify/rate-limit, NFR-SEC-002) ─────────────
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_INQUIRY_MAX=3

# ── Web (apps/web — NEXT_PUBLIC_* is exposed to the browser) ─────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mobile (apps/mobile — EXPO_PUBLIC_* reaches the JS bundle) ───
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
