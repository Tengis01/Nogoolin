# ══════════════════════════════════════════════════════════════════
# Nogoolin — environment variables (NFR-MAIN-008, 08-security.md §11)
# Copy to .env and fill in real values. NEVER commit real secrets.
# All values below are placeholders.
#
# LOCAL DEV: run `pnpm exec supabase start` — it prints the local URL and
# keys. Cloud values arrive in Phase 6 deployment; do NOT create a cloud
# Supabase project before then.
# ══════════════════════════════════════════════════════════════════

# ── API server (backend/api) ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Supabase (API server) ────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
# ⚠️ Server-only — bypasses RLS. Never expose to web or mobile clients,
# never NEXT_PUBLIC_/EXPO_PUBLIC_ prefixed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start

# ── OAuth providers (consumed by supabase/config.toml env substitution) ──
# Leave as placeholders until the OAuth apps are registered — email auth
# works regardless; the web UI shows OAuth buttons as "not configured".
# Redirect URLs to register on each console: see README.md § OAuth setup.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ── CORS (API; comma-separated allowed origins) ──────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting (API; @fastify/rate-limit, NFR-SEC-002) ────────
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_INQUIRY_MAX=3

# ── Web (apps/web — copy into apps/web/.env.local) ───────────────
# NEXT_PUBLIC_* reaches the browser bundle (anon key only — safe).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only (OAuth "configured?" detection on the login page —
# same values as the GOOGLE_/FACEBOOK_ vars above, secrets NOT needed here)
# GOOGLE_CLIENT_ID / FACEBOOK_CLIENT_ID may be repeated in apps/web/.env.local

# ── Mobile (apps/mobile — copy into apps/mobile/.env) ────────────
# EXPO_PUBLIC_* is inlined into the JS bundle (anon key only — safe).
# Use your machine's LAN IP instead of 127.0.0.1 when testing on a device.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
