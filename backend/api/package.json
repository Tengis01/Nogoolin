{
  "name": "@nogoolin/api",
  "version": "0.1.0",
  "private": true,
  "description": "Nogoolin REST API — Fastify + TypeScript, port 3001, Controller → Service → Repository",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.1.1",
    "@nogoolin/validation-schemas": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
