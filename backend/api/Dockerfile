# backend/api/Dockerfile
# Multi-stage build per docs/09-deployment.md §5.2 (NFR-MAIN-006),
# adapted to the finalized backend/api layout (see CLAUDE.md).
# Build context is the monorepo ROOT (required for pnpm workspace resolution):
#   docker build -f backend/api/Dockerfile .

# ── Stage 1: Build ────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

# Copy manifests first so the dependency layer is cached until a
# package.json / lockfile actually changes (not on every source edit).
# pnpm-lock.yaml* glob: tolerates the lockfile not existing yet
# (generated by the first `pnpm install`); once committed, builds
# should use --frozen-lockfile semantics.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/validation-schemas/package.json ./packages/validation-schemas/
COPY backend/api/package.json ./backend/api/

RUN pnpm install --frozen-lockfile

# Now copy source — changes here don't invalidate the install layer
COPY packages/ ./packages/
COPY backend/api/ ./backend/api/

RUN pnpm --filter @nogoolin/api build

# `pnpm deploy` produces a self-contained folder with ONLY production
# dependencies for @nogoolin/api (dev deps, compiler, and unrelated
# workspace packages excluded) — this is what keeps stage 2 lean.
RUN pnpm --filter @nogoolin/api deploy --prod /prod/api

# ── Stage 2: Production ───────────────────────────────────────────
FROM node:20-alpine AS production

# NFR-MAIN-006: run as non-root user
RUN addgroup -S nogoolin && adduser -S nogoolin -G nogoolin

WORKDIR /app

COPY --from=builder --chown=nogoolin:nogoolin /prod/api ./

USER nogoolin

EXPOSE 3001

ENV NODE_ENV=production

# Compiled entrypoint (backend/api tsconfig outputs to dist/)
CMD ["node", "dist/index.js"]
