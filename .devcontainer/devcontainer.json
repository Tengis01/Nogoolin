{
  "name": "Nogoolin documentation (LaTeX + Markdown)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["james-yu.latex-workshop"],
      "settings": {
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.view.pdf.viewer": "tab"
      }
    }
  },
  "postCreateCommand": ["bash", ".devcontainer/check-environment.sh"]
}
